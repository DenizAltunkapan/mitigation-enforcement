    given-names: Deniz
license: MIT
repository-code: "https://github.com/DenizAltunkapan/mitigation-enforcement"
keywords:
  - memory safety
  - exploit mitigations
  - Intel CET shadow stack
  - FORTIFY_SOURCE
  - reproducible research
